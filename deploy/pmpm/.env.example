# Copy to .env on the server and fill in every value:
#   cp .env.example .env && chmod 600 .env && nano .env
# Never commit the filled-in .env.
# The maintenance scripts source this as shell assignments. Single-quote
# literal values containing spaces or shell characters, e.g.
# SMTP_PASSWORD='literal password with $ signs'. Never put commands here.

# --- Site -------------------------------------------------------------------
# The address people will open, e.g. app.pmpm.bg. Its DNS A record must point
# at this server before the first start, or HTTPS cannot be issued.
PMPM_DOMAIN=
# Let's Encrypt sends certificate expiry warnings here.
PMPM_ACME_EMAIL=

# --- Secrets ----------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# --- Image ------------------------------------------------------------------
# CI pushes :main on every merge, and :sha-<commit> for each one. Pin a
# sha- tag here to hold the server on a known version.
# The published image targets linux/amd64: choose an x86-64 Hetzner server.
PMPM_IMAGE=ghcr.io/pmcontrol1/pm-control-erp
PMPM_IMAGE_TAG=main

# closed: only the very first account signs itself up (and becomes admin);
# the admin adds everyone else. admin-approve: anyone may ask, an admin approves.
PMPM_REGISTRATION_MODE=closed

# --- AI ----------------------------------------------------------------------
# The AI provider, key, model and system prompt are set once in the app:
# Settings > AI > Workspace AI. Everyone then uses them; nobody else enters a key.
# Required before public deployment: immutable owner account UUID(s), separated
# by commas. The README private bootstrap prints the first administrator UUID;
# paste it here, then run deploy.sh. A listed owner must be an active admin.
# Blank is safe for private bootstrap and grants no AI ownership.
# Other administrators have employee AI access only. Email lists are not used.
PMPM_PLATFORM_OWNER_USER_IDS=

# --- Email -------------------------------------------------------------------
# The sender of every email the platform sends, e.g. noreply@pmpm.bg.
SMTP_FROM=
# console = emails are only written to the log (fine to start with).
# smtp    = really send, through the server below (your mail provider's SMTP).
PMPM_EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Backups (backup.sh) ----------------------------------------------------
# Where backups go: any S3-compatible bucket in a different place from this
# server (Hetzner Object Storage, Backblaze B2, AWS S3 ...). Format:
#   s3:https://<endpoint>/<bucket>/pmpm
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Encrypts the backups. Without it they cannot be read, so keep a copy
# somewhere other than this server (a password manager). Generate with:
#   openssl rand -base64 32
# Also keep an encrypted off-server copy of .env and these deployment files;
# data snapshots intentionally do not include server credentials/configuration.
RESTIC_PASSWORD=
# Optional: a URL pinged after each backup (e.g. a healthchecks.io check), so
# you get an email if a night is missed. backup.sh appends /fail on failure.
BACKUP_PING_URL=
